# The app itself is client-side, but "Email" needs a serverless function (api/send-email.ts).
# Set these in Vercel -> Project -> Settings -> Environment Variables (or in a local .env for `vercel dev`).
# They have NO "VITE_" prefix on purpose, so they are never bundled into the browser code.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true for port 465 (implicit TLS); false/omitted for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
# Gmail: use an App Password (requires 2-Step Verification), not your normal password
SMTP_PASS=
# Optional: defaults to SMTP_USER
EMAIL_FROM="Moy Tracker <your-address@gmail.com>"
# Optional but recommended: only allow these recipients (addresses and/or @domains)
# EMAIL_ALLOWED_RECIPIENTS=me@example.com,@mycompany.com

# Optional: only if the API is hosted somewhere other than this site
# VITE_API_BASE_URL=https://api.example.com
